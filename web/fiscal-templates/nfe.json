    },
    {
      "id": "cst_cofins",
      "label": "CST COFINS",
      "sql": "nfe_itens.imposto_cofins_cst"
    },
    {
      "id": "monofasico",
      "label": "NCM monofásico",
      "sql": "CASE nfe_itens.ncm_monofasico WHEN 'S' THEN 'Sim' WHEN 'N' THEN 'Não' END"
    },
    {
      "id": "no_sped_contribuicoes",
      "label": "Consta na EFD Contribuições",
      "sql": "CASE nfe_itens.contem_sped_piscofins WHEN 'S' THEN 'Sim' WHEN 'N' THEN 'Não' END"
    },
    {
      "id": "no_sped_icms",
      "label": "Consta na EFD ICMS/IPI",
      "sql": "CASE nfe_itens.contem_sped_icms WHEN 'S' THEN 'Sim' WHEN 'N' THEN 'Não' END"
