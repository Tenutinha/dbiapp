    },
    {
      "id": "cnpj_emitente",
      "label": "CNPJ do emitente",
      "sql": "nfe_itens.emit_cnpj"
    },
    {
      "id": "uf_emitente",
      "label": "UF do emitente",
      "sql": "CASE left(nfe_itens.chnfe_xml, 2) WHEN '11' THEN 'RO' WHEN '12' THEN 'AC' WHEN '13' THEN 'AM' WHEN '14' THEN 'RR' WHEN '15' THEN 'PA' WHEN '16' THEN 'AP' WHEN '17' THEN 'TO' WHEN '21' THEN 'MA' WHEN '22' THEN 'PI' WHEN '23' THEN 'CE' WHEN '24' THEN 'RN' WHEN '25' THEN 'PB' WHEN '26' THEN 'PE' WHEN '27' THEN 'AL' WHEN '28' THEN 'SE' WHEN '29' THEN 'BA' WHEN '31' THEN 'MG' WHEN '32' THEN 'ES' WHEN '33' THEN 'RJ' WHEN '35' THEN 'SP' WHEN '41' THEN 'PR' WHEN '42' THEN 'SC' WHEN '43' THEN 'RS' WHEN '50' THEN 'MS' WHEN '51' THEN 'MT' WHEN '52' THEN 'GO' WHEN '53' THEN 'DF' END"
    },
    {
      "id": "destinatario",
      "label": "Destinatário",
      "sql": "nfe_itens.dest_nome"
    },
    {
      "id": "cnpj_destinatario",
      "label": "CNPJ do destinatário",
      "sql": "nfe_itens.dest_cnpj"
    },
    {
      "id": "natureza_operacao",
      "label": "Natureza da operação",
      "sql": "nfe_itens.ide_natop"
    },
    {
      "id": "cfop",
      "label": "CFOP",
      "sql": "nfe_itens.prod_cfop"
    },
    {
      "id": "ncm",
      "label": "NCM",
      "sql": "nfe_itens.prod_ncm"
    },
    {
      "id": "capitulo_ncm",
      "label": "Capítulo do NCM",
      "sql": "left(nfe_itens.prod_ncm, 2)"
    },
    {
      "id": "produto",
      "label": "Produto",
      "sql": "nfe_itens.prod_xprod"
    },
    {
