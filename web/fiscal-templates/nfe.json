  "relationships": [],
  "fields": [
    {
      "id": "ano",
      "label": "Ano",
      "sql": "CAST(year(nfe_itens.emissao_data) AS VARCHAR)"
    },
    {
      "id": "mes",
      "label": "Mês",
      "sql": "strftime(nfe_itens.emissao_data, '%Y-%m')"
    },
    {
      "id": "emissao",
      "label": "Emissão",
      "sql": "CASE nfe_itens.emitente WHEN 'PRÓPRIO' THEN 'Própria' WHEN 'TERCEIRO' THEN 'De terceiros' ELSE nfe_itens.emitente END"
    },
    {
      "id": "modelo",
      "label": "Modelo",
      "sql": "nfe_itens.ide_mod"
    },
    {
      "id": "emitente",
      "label": "Emitente",
