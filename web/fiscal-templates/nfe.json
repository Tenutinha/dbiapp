      "sql": "SUM(nfe_itens.prod_vprod) - COALESCE(SUM(nfe_itens.prod_vdesc), 0)",
      "format": "currency"
    },
    {
      "id": "base_icms",
      "label": "Base de cálculo do ICMS",
      "sql": "SUM(nfe_itens.imposto_icms_vbc)",
      "format": "currency"
    },
    {
      "id": "icms",
      "label": "ICMS",
      "sql": "SUM(nfe_itens.imposto_icms_vicms)",
      "format": "currency"
    },
    {
      "id": "icms_st",
      "label": "ICMS-ST",
      "sql": "SUM(nfe_itens.imposto_icmsst_vicmsst)",
      "format": "currency"
    },
    {
      "id": "ipi",
      "label": "IPI",
      "sql": "SUM(nfe_itens.imposto_ipi_vipi)",
      "format": "currency"
    },
    {
      "id": "pis",
      "label": "PIS",
      "sql": "SUM(nfe_itens.imposto_pis_vpis)",
      "format": "currency"
    },
    {
      "id": "cofins",
      "label": "COFINS",
      "sql": "SUM(nfe_itens.imposto_cofins_vcofins)",
      "format": "currency"
    },
    {
      "id": "tributos",
      "label": "Tributos destacados",
      "sql": "COALESCE(SUM(nfe_itens.imposto_icms_vicms), 0) + COALESCE(SUM(nfe_itens.imposto_icmsst_vicmsst), 0) + COALESCE(SUM(nfe_itens.imposto_ipi_vipi), 0) + COALESCE(SUM(nfe_itens.imposto_pis_vpis), 0) + COALESCE(SUM(nfe_itens.imposto_cofins_vcofins), 0)",
      "format": "currency"
    },
    {
      "id": "carga_tributaria",
      "label": "Carga tributária destacada",
      "sql": "(COALESCE(SUM(nfe_itens.imposto_icms_vicms), 0) + COALESCE(SUM(nfe_itens.imposto_icmsst_vicmsst), 0) + COALESCE(SUM(nfe_itens.imposto_ipi_vipi), 0) + COALESCE(SUM(nfe_itens.imposto_pis_vpis), 0) + COALESCE(SUM(nfe_itens.imposto_cofins_vcofins), 0)) / NULLIF(SUM(nfe_itens.prod_vprod), 0)",
      "format": "percent"
    },
    {
      "id": "notas",
      "label": "Notas",
      "sql": "COUNT(DISTINCT nfe_itens.chnfe_xml)",
      "format": "integer"
    },
    {
      "id": "itens",
      "label": "Itens",
      "sql": "COUNT(*)",
      "format": "integer"
    },
    {
      "id": "valor_medio_nota",
      "label": "Valor médio por nota",
      "sql": "SUM(nfe_itens.prod_vprod) / NULLIF(COUNT(DISTINCT nfe_itens.chnfe_xml), 0)",
      "format": "currency"
    },
    {
      "id": "quantidade",
      "label": "Quantidade",
      "sql": "SUM(nfe_itens.prod_qcom)",
      "format": "number"
    }
  ],
