# Copy to .env.local and fill in
DBI_DB_PASSWORD=change-me
DATABASE_URL=postgres://dbi:change-me@localhost:54329/dbi
# Where Parquet files are stored (local disk for now; Supabase Storage later)
DBI_STORAGE_DIR=./storage
# MVP has no login yet: every request acts as this seeded user
DBI_DEMO_USER_EMAIL=demo@dbi.local
# Dev-only "entrar como" user switcher (ignored in production builds)
DBI_DEV_AUTH=true
# Max memory DuckDB may use for dashboard queries (e.g. 2GB, 512MB)
DBI_DUCKDB_MEMORY_LIMIT=2GB
