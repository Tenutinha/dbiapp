# Copy to .env.local and fill in. Defaults run everything locally (Docker Postgres + disk).

# --- Database ---------------------------------------------------------------
DBI_DB_PASSWORD=change-me
DATABASE_URL=postgres://dbi:change-me@localhost:54329/dbi
# Production (Supabase): use the *transaction pooler* URL (port 6543)

# --- Login ------------------------------------------------------------------
# dev      = "entrar como" switcher (development only, never in production builds)
# supabase = magic link by e-mail (Supabase Auth)
DBI_AUTH=dev
DBI_DEV_AUTH=true
DBI_DEMO_USER_EMAIL=demo@dbi.local

# --- Files ------------------------------------------------------------------
# local    = DBI_STORAGE_DIR on this machine
# supabase = private Supabase Storage bucket (DBI_STORAGE_BUCKET)
DBI_STORAGE_DRIVER=local
DBI_STORAGE_DIR=./storage
DBI_STORAGE_BUCKET=dbi

# --- Supabase (production) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret, used for Storage. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Engine -----------------------------------------------------------------
# Max memory DuckDB may use for dashboard queries (e.g. 2GB, 1GB, 512MB)
DBI_DUCKDB_MEMORY_LIMIT=2GB

# --- Seed -------------------------------------------------------------------
# Your own user as platform administrator ("admin master")
DBI_PLATFORM_ADMIN_EMAIL=voce@exemplo.com
DBI_PLATFORM_ADMIN_NAME=Seu Nome
